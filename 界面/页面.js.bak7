/*!
 * 界面/页面.js — 总览、基本信息、决策输入、行动计划、导出 五个页面
 */
(function (root) {
  'use strict';
  var CP = (root.CP = root.CP || {});
  CP.pages = CP.pages || {};

  var esc = function (s) { return CP.esc(s); };

  function head(title, sub) {
    return '<div class="page-head"><h1>' + esc(title) + '</h1>' +
      (sub ? '<div class="sub">' + sub + '</div>' : '') + '</div>';
  }

  function progressBlock() {
    var pr = CP.ui.progress();
    var rows = pr.parts.map(function (p) {
      // 条形宽度与右侧文字必须同源，否则会出现"条是满的、文字写 8/48"的矛盾。
      // 勾选式清单的门槛（每维至少勾 1 项）远小于题目总数，所以它的条会比
      // 达标判据先走完——这是有意的：门槛达成即算做完，实际勾了多少如实显示。
      var frac = p.total ? Math.min(1, p.done / p.total) : 0;
      return '<div class="progress-row">' +
        '<span class="pv-label">' + esc(p.label) +
        (p.reached ? ' <span style="color:var(--ok)">✓</span>' : '') + '</span>' +
        '<div class="progress"><i style="width:' + (frac * 100).toFixed(0) + '%"></i></div>' +
        '<b class="pv-count">' + esc(p.countHint) + '</b></div>';
    }).join('');

    // 总进度也做成一行（有标签、有数值），而不是一条孤零零的加粗进度条。
    //
    // 之前的问题：条与上一行的间距是"上一行 margin-bottom 8px"加"本条 margin-top 6px"
    // 叠出来的 14px，比行间距大一截，看起来像脱离了上面的列表；而且没有文字，
    // 只有右上角的百分比标签，不知道这条代表什么。
    // 现在用和上面几行完全相同的结构与间距，标签写「总完成进度」。
    var totalPct = Math.round(pr.pct * 100);
    return '<div class="card"><div class="card-head"><h3>完成进度</h3>' +
      '<span class="tag tag-brand">' + totalPct + '%</span></div>' +
      '<div class="progress-parts">' + rows + '</div>' +
      '<div class="progress-row progress-total">' +
      '<span class="pv-label">总完成进度</span>' +
      '<div class="progress progress-lg"><i style="width:' + (pr.pct * 100).toFixed(0) + '%"></i></div>' +
      '<b class="pv-count">' + totalPct + '%</b></div>' +
      '</div>';
  }

  /* ============================================================
   * 总览
   * ============================================================ */
  CP.pages.home = function () {
    var a = CP.ui.archive;
    var missing = CP.validateArchive(a);
    var pr = CP.ui.progress();
    var hasResult = !!(a.computed && a.computed.match);

    var steps = [
      { t: '填写基本信息', d: '年级、专业方向、GPA 档位、是否接受读研。只有四项，其中年级会决定能力自评的问法与适配度权重。', r: 'profile', btn: '去填写' },
      { t: '兴趣测评', n: '36 题', d: '霍兰德 RIASEC 六维，用来定位你喜欢做什么。这一步的结果在大一模式下的权重最高。', r: 'riasec', btn: '开始测评' },
      { t: '职业锚测评', n: '40 题', d: '施恩八锚，用来定位你在职业里最不能放弃什么。它和兴趣不是一回事。', r: 'anchor', btn: '开始测评' },
      { t: '能力自评', n: '24 题', d: '题目与量程随年级切换：大一问"接触过什么"，其他年级问"做到过什么"。', r: 'ability', btn: '开始测评' },
      { t: '决策输入', d: '标记岗位偏好、给 6 项标准排序、给 6 条候选路径打分、填每周可投入时长。', r: 'decision', btn: '去填写' },
      { t: '查看结果与画像', d: '得到量化适配度排序、行业职业简表、差距清单与路径决策。所有数值都能点开核对。', r: 'result', btn: '看结果' },
      { t: '生成行动计划', d: '把差距和里程碑变成带截止日的任务，进入学期看板，配复盘记录。', r: 'action', btn: '去安排' },
      { t: '导出报告', d: '导出规划报告（总结性文字，可打印为 PDF）、原始数据（供核查）与档案 JSON（可备份）。', r: 'export', btn: '去导出' }
    ];

    var stepHtml = steps.map(function (s, i) {
      return '<div class="step" onclick="location.hash=\'' + s.r + '\'">'
        + '<div class="step-no">' + (i + 1) + '</div>'
        + '<div class="step-body"><b>' + esc(s.t) + (s.n ? ' <span class="step-n">' + esc(s.n) + '</span>' : '') + '</b>'
        + '<span>' + esc(s.d) + '</span></div>'
        + '<div class="step-go">' + esc(s.btn) + ' <span aria-hidden="true">→</span></div>'
        + '</div>';
    }).join('');

    return '<section class="hero">'
      + '<div class="hero-text">'
      + '<span class="hero-kicker">人工智能专业 · 课程实践</span>'
      + '<h1>职业生涯规划<br>学习实践工作台</h1>'
      + '<p>把「自我认知 → 行业认知 → 目标决策 → 能力锻造 → 行动追踪」做成一条可量化、可追溯、可导出的完整链路。'
      + '全部数据只保存在你本机浏览器里，不联网、不上传。</p>'
      + '<div class="hero-actions">'
      + '<button class="btn btn-primary" onclick="location.hash=\'profile\'">从第一步开始</button>'
      + '<button class="btn" id="heroDemo">先看示例档案</button>'
      + '</div>'
      + '</div>'
      + '<div class="hero-art" aria-hidden="true"></div>'
      + '</section>'

      + '<div class="grid grid-3" style="margin-bottom:18px">'
      + '<div class="metric is-accent"><div class="k">总体完成度</div><div class="v">' + Math.round(pr.pct * 100) + '<small>%</small></div>'
      + '<div class="progress" style="margin-top:8px"><i style="width:' + (pr.pct * 100).toFixed(0) + '%"></i></div></div>'
      + '<div class="metric"><div class="k">待完成项</div><div class="v">' + missing.length + '<small>项</small></div>'
      + '<div class="d">' + (missing.length ? '见下方清单' : '已全部完成') + '</div></div>'
      + '<div class="metric"><div class="k">结果快照</div><div class="v" style="font-size:18px">' + (hasResult ? '已生成' : '未生成') + '</div>'
      + '<div class="d">' + (hasResult ? '生成于 ' + esc(CP.localTime(a.computed.generatedAt)) : '填完后到「结果与画像」页生成') + '</div>'
      // 显示"最后保存于"：档案存的是 UTC 时刻，必须转成本地时间再显示，
      // 否则东八区下会少 8 小时（曾经就是把 ISO 串切一刀直接显示的）。
      + '<div class="d" style="font-size:11.5px;color:var(--ink-3)">最后保存 '
      + esc(CP.localTime(a.updatedAt || a.createdAt)) + '</div></div>'
      + '</div>'

      + progressBlock()
      + '<div class="card"><div class="card-head"><h3>八步流程</h3><span class="tag">建议按顺序完成，点击任意一步可直接跳转</span></div>'
      + '<div class="steps">' + stepHtml + '</div>'
      + '</div>'

      + (missing.length
        ? '<div class="card"><div class="card-head"><h3>还差这些</h3><span class="tag tag-warn">' + missing.length + ' 项</span></div><ul class="todo-list">'
          + missing.map(function (m) { return '<li>' + esc(m) + '</li>'; }).join('') + '</ul></div>'
        : '')
      + '<div class="card"><div class="card-head"><h3>开始之前</h3></div><div class="disclaimer">'
      + '<p><b>这不是心理诊断工具。</b>本工作台的测评改编自霍兰德职业兴趣理论、施恩职业锚理论等公开框架，题目为课程实践自编，不等同于任何标准化心理量表，结果仅作生涯规划参考。</p>'
      + '<p><b>岗位库是示例数据。</b>11 个岗位族的能力要求、工作内容时间分配与薪资区间是对公开行业报告和招聘信息描述的结构化转写，用于教学演示，不代表实时招聘行情。来源清单见 <code>情报库/岗位来源.md</code>。</p>'
      + '<p><b>你拥有最终决定权。</b>所有推荐都由页面公开的公式算出，每个分数都能点开「查看推导」核对。当第一、二名分差很小时，页面会主动提示你不要盲从排序。</p>'
      + '<p><b>数据不出本机。</b>作答保存在浏览器 localStorage；换电脑请先导出档案 JSON，在新机器上导入。</p>'
      + '</div></div>';
  };

  /** 载入示例档案：确认返回 true 走大一示例，false 走大三示例 */
  CP.loadDemoArchive = function () {
    var fresh = confirm('载入示例档案会覆盖当前进度。\n\n确定 = 载入「大一」示例（演示以兴趣定方向的口径）\n取消 = 载入「大三」示例（演示以能力匹配为主的口径）');
    CP.ui.archive = fresh ? CP.demoArchiveFresh() : CP.demoArchive();
    CP.store.save(CP.ui.archive);
    CP.ui.go('result', { keepScroll: false });
    CP.ui.refreshProgress();
    CP.ui.toast('已载入' + (fresh ? '「大一」' : '「大三」') + '示例档案');
  };

  CP.pages.homeBind = function () {
    var b = document.getElementById('heroDemo');
    if (b) b.onclick = function () { CP.loadDemoArchive(); };
  };

  /* ============================================================
   * 基本信息
   * 只保留真正有用的四项。城市移到决策输入（它是倾向不是门槛），
   * 每周时长移到决策输入（它是排期参数不是身份信息），
   * 自由文本的"其他限制"已删除（无法量化，只会被原样复述进报告）。
   * ============================================================ */
  CP.pages.profile = function () {
    var p = CP.ui.archive.profile;

    function select(id, label, options, hint) {
      return '<label class="field"><span class="lbl">' + esc(label) + '</span>'
        + '<select id="' + id + '">'
        + '<option value="">请选择</option>'
        + options.map(function (o) {
          return '<option value="' + esc(o) + '"' + (p[id] === o ? ' selected' : '') + '>' + esc(o) + '</option>';
        }).join('')
        + '</select>' + (hint ? '<span class="hint">' + esc(hint) + '</span>' : '') + '</label>';
    }

    // GPA 档位对**所有年级**都给出同一组选项。
    //
    // 早先的处理是"大一不显示这一项"（展示一个禁用的文本框"不适用"）。
    // 那样有两个问题：一是把"没评定"这个真实情况表达成了"这一项对你不适用"，
    // 二是把档位与年级硬绑在一起，改年级还要清空数据。
    // 现在统一成一组选项，"尚未评定"与"不便填写"各是一个**明确的答案**：
    //   尚未评定 —— 大一/刚入学，学校还没出排名（大二以上也可能遇到）
    //   不便填写 —— 学生知道但不愿提供（例如排名靠后，属隐私）
    // 两者都不参与任何计算，与"不选"的区别只是"说明白了"还是"留空"。
    var gpaField = select('gpaBand', 'GPA 档位',
      ['前 10%', '10-30%', '30-60%', '后 40%', '尚未评定', '不便填写'],
      '所有年级都适用。仅作为参考信息记录，不参与任何计算；不清楚或不愿填可选对应项。');

    return head('基本信息', '只有四项，都不会参与适配度打分。')
      + '<div class="card">'
      + '<div class="grid grid-2">'
      + '<div>'
      + select('grade', '年级', ['大一', '大二', '大三', '大四', '研一', '研二', '研三'],
        '年级决定两件事：能力自评用哪套问法、岗位适配度用哪套权重。')
      + select('track', '专业方向', ['人工智能', '智能科学与技术', '计算机科学与技术', '自动化', '电子信息', '其他'])
      + '</div><div>'
      + gpaField
      + select('acceptPostgrad', '是否接受读研', ['接受', '不接受', '未定'],
        '这是本页唯一参与计算的一项：选"不接受"时，门槛为硕士及以上的岗位会被排除。')
      + '</div></div>'
      + '</div>'
      + (p.grade
        ? ''
        : '<div class="note note-warn" style="margin-top:14px">请先选择年级。</div>');
  };

  CP.pages.profileBind = function () {
    ['grade', 'track', 'gpaBand', 'acceptPostgrad'].forEach(function (k) {
      var el = document.getElementById(k);
      if (el) el.onchange = function () {
        CP.ui.setField('profile.' + k, el.value);
        if (k === 'grade') {
          // 年级变化会切换能力自评口径，已作答的能力题必须清空，否则两套题号混在一起
          var changed = CP.ui.archive.answers.ability && Object.keys(CP.ui.archive.answers.ability).length > 0;
          CP.ui.archive.answers.ability = {};
          CP.ui.archive.computed = null;
          CP.store.save(CP.ui.archive);
          CP.ui.go('profile', { keepScroll: false });
          CP.ui.toast(changed ? '年级已改变，能力自评已按新口径重置，请重新作答' : '年级已更新，能力自评将使用新口径');
          return;
        }
        CP.ui.refreshProgress();
      };
    });
  };

  /* ============================================================
   * 决策输入
   * ============================================================ */
  var CITY_SUGGEST = ['北京', '上海', '深圳', '杭州', '广州', '成都', '南京', '武汉', '西安', '苏州', '合肥', '其他'];
  var DUTY_KEYS = CP.DUTY_KEYS;   // 定义在 数据/schema.js，导出层也用同一份

  CP.pages.decision = function () {
    var a = CP.ui.archive;
    var d = a.decision;

    /* 5.1 岗位偏好 */
    var jobsHtml = CP.JOB_FAMILIES.map(function (j) {
      var s = d.jobPref[j.id] || 'unmarked';
      return '<div style="display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line-2)">'
        + '<div style="flex:1 1 auto"><b style="font-size:13.5px">' + esc(j.name) + '</b> '
        + '<span class="tag">' + esc(j.family) + '</span>'
        + '<div style="font-size:12.5px;color:var(--ink-2);margin-top:2px">' + esc(j.summary) + '</div>'
        + '<div style="font-size:11.5px;color:var(--ink-3);margin-top:3px">学历门槛：' + esc(j.minEdu) + '｜' + esc(j.salaryBand) + '</div></div>'
        + '<div class="chips" style="flex:0 0 auto">'
        + ['like', 'neutral', 'exclude'].map(function (v) {
          var label = v === 'like' ? '感兴趣' : (v === 'neutral' ? '不排斥' : '排除');
          return '<span class="chip' + (s === v ? ' on' : '') + (v === 'exclude' && s === v ? ' chip-x' : '') + '" data-pref="' + j.id + '" data-val="' + v + '">' + label + '</span>';
        }).join('')
        + '</div></div>';
    }).join('');

    /* 5.2 标准排序 */
    var order = (d.criteriaOrder && d.criteriaOrder.length === CP.CRITERIA.length)
      ? d.criteriaOrder
      : CP.CRITERIA.map(function (c) { return c.id; });
    var sortHtml = order.map(function (cid, idx) {
      var c = CP.CRITERIA.filter(function (x) { return x.id === cid; })[0];
      // data-sortcid 是 FLIP 动画的定位标记：整页重渲染后按 id 找回同一行，
      // 才能算出它从哪里滑到哪里。见 bindPage 里的 sortFlip。
      return '<div class="sortrow" data-sortcid="' + esc(cid) + '">'
        + '<span class="rank">' + (idx + 1) + '</span>'
        + '<span class="lbl">' + esc(c.label) + '<i>' + esc(c.hint) + '</i></span>'
        + '<span class="mv">'
        + '<button class="btn btn-sm" data-move="up" data-cid="' + cid + '"' + (idx === 0 ? ' disabled' : '') + '>↑</button>'
        + '<button class="btn btn-sm" data-move="down" data-cid="' + cid + '"' + (idx === order.length - 1 ? ' disabled' : '') + '>↓</button>'
        + '</span></div>';
    }).join('');

    /* 5.3 路径打分 */
    var pathTotals = {};
    CP.decidePaths(a).ranked.forEach(function (r) { pathTotals[r.pathId] = r.shown; });
    var pathHtml = CP.PATHS.map(function (p) {
      var cells = CP.CRITERIA.map(function (c) {
        var v = CP.pathScore(a, p.id, c.id);
        var overridden = (d.pathScores[p.id] || {})[c.id] !== undefined;
        return '<td class="num"><select data-path="' + p.id + '" data-crit="' + c.id + '" style="width:64px;padding:3px 4px;' + (overridden ? 'border-color:var(--brand)' : '') + '">'
          + [1, 2, 3, 4, 5].map(function (n) {
            return '<option value="' + n + '"' + (v === n ? ' selected' : '') + '>' + n + '</option>';
          }).join('')
          + '</select></td>';
      }).join('');
      return '<tr><td><b>' + esc(p.name) + '</b><div style="font-size:11.5px;color:var(--ink-3);margin-top:2px">' + esc(p.summary) + '</div></td>'
        + cells + '<td class="num"><b>' + (pathTotals[p.id] == null ? '—' : pathTotals[p.id]) + '</b></td></tr>';
    }).join('');

    /* 5.4 时间与城市偏好 */
    var cityChips = CITY_SUGGEST.map(function (c) {
      return '<span class="chip' + (d.targetCities.indexOf(c) >= 0 ? ' on' : '') + '" data-city="' + esc(c) + '">' + esc(c) + '</span>';
    }).join('');

    /* 5.5 已被移除：生涯人物访谈不再作为必做项 */

    return head('决策输入',
      '这一部分<b>由你自己下判断</b>。页面不会替你排序，只会把你的偏好按权重折算成得分，并把结果摊开给你看。'
      + '所有输入都是可选项或可填数字的项——没有"谈谈你的感想"这类无法量化的题目。')

      + '<div class="card"><div class="card-head"><h3>5.1 岗位偏好</h3><span class="tag">至少标记一个"感兴趣"</span></div>'
      + '<div class="note" style="margin-bottom:10px">标"排除"的岗位族会被直接过滤掉；标"感兴趣"的不会自动加分，它只用于筛选范围。是否匹配由测评数据决定，不由主观愿望决定。</div>'
      + jobsHtml + '</div>'
      + '<div class="card"><div class="card-head"><h3>5.2 决策标准排序</h3><span class="tag tag-brand">权重来源</span></div>'
      + '<div class="note" style="margin-bottom:10px">排序决定了 6 项标准在路径决策里的权重（第 1 位权重最大，线性递减）。这个权重<b>只用于候选路径的比较</b>，不影响岗位适配度。</div>'
      + '<div class="sortlist">' + sortHtml + '</div></div>'

      + '<div class="card"><div class="card-head"><h3>5.3 候选路径评分</h3><span class="tag">1 = 完全不能接受，5 = 非常契合</span></div>'
      + '<div class="note" style="margin-bottom:10px">表格里已预填了一套参考值，你可以直接改。被改过的单元格边框会变成主题色——<b>改动越多，结果越是你自己的判断</b>。</div>'
      + '<div class="table-wrap"><table><thead><tr><th>候选路径</th>'
      + CP.CRITERIA.map(function (c) { return '<th class="num">' + esc(c.label) + '</th>'; }).join('')
      + '<th class="num">加权得分</th></tr></thead><tbody>' + pathHtml + '</tbody></table></div></div>'

      + '<div class="card"><div class="card-head"><h3>5.4 时间与城市</h3><span class="tag">排期参数</span></div>'
      + '<label class="field"><span class="lbl">每周可投入学习时长（小时）</span>'
      + '<input type="number" id="hoursPerWeek" min="0" max="80" value="' + (d.hoursPerWeek == null ? '' : d.hoursPerWeek) + '">'
      + '<span class="hint">用来把能力缺口换算成排期周数。学生普遍高估自己，建议按真实情况填。</span></label>'
      + '<label class="field"><span class="lbl">期望工作城市（可不选）</span>'
      + '<div class="chips" id="cityChips">' + cityChips + '</div>'
      + '<span class="hint">仅作为你自己的倾向记录，<b>不参与任何筛选或计算</b>。岗位库没有逐岗标注城市，强行按城市过滤只会让你连结果都看不到。</span></label>'
      + '</div>';
  };

  CP.pages.decisionBind = function () {
    var a = CP.ui.archive;
    // 原地重渲染：保住滚动位置，否则每点一下按钮页面都会跳回顶端
    function rerender() { CP.ui.go('decision'); }

    // 岗位偏好
    document.querySelectorAll('[data-pref]').forEach(function (chip) {
      chip.onclick = function () {
        var id = chip.getAttribute('data-pref');
        var val = chip.getAttribute('data-val');
        if (a.decision.jobPref[id] === val) delete a.decision.jobPref[id];
        else a.decision.jobPref[id] = val;
        a.computed = null;
        CP.store.save(a);
        rerender();
      };
    });

    // 排序
    // 排序：上下移动时让两行滑动过去，而不是瞬间换位。
    //
    // 为什么不能只用 CSS transition：移动会走 rerender()，那一步把整个
    // #view 的 innerHTML 换掉——**旧元素被移除，新元素重新插入**，
    // 元素之间没有任何可插值的状态，CSS 只会看到"跳变"。
    // 所以用经典的 FLIP：先量旧位置 → 重渲染 → 量新位置 → 用 WAAPI
    // 从旧位置滑到新位置。位移在整个过程中是连续可读的。
    function sortFirstPositions() {
      var map = {};
      document.querySelectorAll('.sortrow[data-sortcid]').forEach(function (el) {
        map[el.getAttribute('data-sortcid')] = el.getBoundingClientRect().top;
      });
      return map;
    }
    function sortFlipPlay(first) {
      if (!first) return;
      if (CP.ui.motionReduced && CP.ui.motionReduced()) return;
      document.querySelectorAll('.sortrow[data-sortcid]').forEach(function (el) {
        var id = el.getAttribute('data-sortcid');
        if (!(id in first)) return;
        var dy = first[id] - el.getBoundingClientRect().top;
        if (!dy) return;                       // 没动的行不播
        if (typeof el.animate !== 'function') return;
        el.animate([
          { transform: 'translateY(' + dy + 'px)' },
          { transform: 'translateY(0)' }
        ], { duration: 240, easing: 'cubic-bezier(.22,.61,.36,1)' });
      });
    }

    document.querySelectorAll('[data-move]').forEach(function (btn) {
      btn.onclick = function () {
        var cid = btn.getAttribute('data-cid');
        var dir = btn.getAttribute('data-move');
        var order = (a.decision.criteriaOrder && a.decision.criteriaOrder.length === CP.CRITERIA.length)
          ? a.decision.criteriaOrder.slice()
          : CP.CRITERIA.map(function (c) { return c.id; });
        var i = order.indexOf(cid);
        var j = dir === 'up' ? i - 1 : i + 1;
        if (j < 0 || j >= order.length) return;
        order[i] = order[j]; order[j] = cid;
        a.decision.criteriaOrder = order;
        a.computed = null;
        CP.store.save(a);

        // FLIP：量旧位置 → 重渲染 → 量新位置 → 播
        var first = sortFirstPositions();
        // afterRender 在 render() 把内容写好之后执行，此时新位置已经可量。
        // ★ 按钮反馈必须在这里加，不能在这里之前：rerender() 会把整个 #view
        //   重写，之前加在旧按钮上的类随旧元素一起被丢弃，界面上什么也看不到。
        CP.ui.afterRender = function () {
          sortFlipPlay(first);
          if (CP.ui.motionReduced && CP.ui.motionReduced()) return;
          var fresh = document.querySelector(
            '.sortrow[data-sortcid="' + cid + '"] [data-move="' + dir + '"]');
          if (!fresh) return;
          fresh.classList.remove('mv-hit');
          void fresh.offsetWidth;                 // 强制重算，保证连点也能重播
          fresh.classList.add('mv-hit');
          fresh.addEventListener('animationend', function onHit() {
            fresh.classList.remove('mv-hit');
            fresh.removeEventListener('animationend', onHit);
          });
        };
        rerender();
      };
    });

    // 路径评分：原地重渲染会丢失当前焦点，所以只更新这一行的合计，不整页刷新
    document.querySelectorAll('[data-path]').forEach(function (sel) {
      sel.onchange = function () {
        var pid = sel.getAttribute('data-path');
        var cid = sel.getAttribute('data-crit');
        a.decision.pathScores[pid] = a.decision.pathScores[pid] || {};
        a.decision.pathScores[pid][cid] = Number(sel.value);
        a.computed = null;
        CP.store.save(a);
        // 只刷新这一行的得分与"改过"标记，避免整页重渲染打断操作
        var rowTotal = CP.decidePaths(a).ranked.filter(function (r) { return r.pathId === pid; })[0];
        var td = sel.closest('tr').querySelector('td:last-child b');
        if (td && rowTotal) td.textContent = rowTotal.shown;
        sel.style.borderColor = 'var(--brand)';
        CP.ui.refreshProgress();
      };
    });

    // 城市偏好
    document.querySelectorAll('[data-city]').forEach(function (chip) {
      chip.onclick = function () {
        var city = chip.getAttribute('data-city');
        var list = a.decision.targetCities.slice();
        var i = list.indexOf(city);
        if (i >= 0) list.splice(i, 1); else list.push(city);
        a.decision.targetCities = list;
        CP.store.save(a);
        rerender();
      };
    });

    // 每周时长
    var h = document.getElementById('hoursPerWeek');
    if (h) h.onchange = function () {
      a.decision.hoursPerWeek = h.value === '' ? null : Number(h.value);
      a.computed = null;
      CP.store.save(a);
      CP.ui.refreshProgress();
    };
  };

  /* ============================================================
   * 行动计划
   * ============================================================ */
  CP.pages.action = function () {
    var a = CP.ui.archive;
    var res = CP.ui.result();
    var actions = a.actions || [];

    function col(status, title) {
      var list = actions.filter(function (x) { return x.status === status; });
      // data-col 与 data-actid 是动画定位标记：
      //   列名用来判断"卡片进的是哪一列"，据此给它对应的状态色反馈；
      //   卡片 id 用来在整页重渲染后找回同一张卡（见 bindPage 里的 actMove）。
      return '<div class="kan-col" data-col="' + status + '"><h4><span>' + esc(title) + '</span><span>' + list.length + '</span></h4>'
        + (list.length ? list.map(function (x) {
          var i = actions.indexOf(x);
          return '<div class="kan-item" data-actid="' + esc(x.id) + '"><div>' + esc(x.title) + '</div>'
            + '<div class="due">' + esc(x.due || '未设截止') + (x.fromGap ? ' · 来自差距：' + esc(CP.abilityLabel(x.fromGap)) : '') + '</div>'
            + (x.note ? '<div style="font-size:11.5px;color:var(--ink-3);margin-top:3px">' + esc(x.note) + '</div>' : '')
            + '<div class="ops">'
            + '<button class="btn btn-sm" data-mv="' + i + '" data-to="todo">待做</button>'
            + '<button class="btn btn-sm" data-mv="' + i + '" data-to="doing">进行中</button>'
            + '<button class="btn btn-sm" data-mv="' + i + '" data-to="done">已完成</button>'
            + '<button class="btn btn-sm" data-del="' + i + '">删除</button>'
            + '</div></div>';
        }).join('') : '<div style="font-size:12px;color:var(--ink-3)">暂无</div>')
        + '</div>';
    }

    var gaps = res.gaps || [];
    var gapCards = gaps.map(function (g) {
      var isExplore = g.dim === '_explore';
      return '<div class="card" style="box-shadow:none"><div class="card-head"><h3>' + esc(g.label) + '</h3>'
        + (isExplore
          ? '<span class="tag tag-brand">第一步</span>'
          : '<span class="tag tag-danger">缺口 ' + esc(g.gap) + ' 分</span>')
        + '</div>'
        + (isExplore
          ? '<div style="font-size:12.5px;color:var(--ink-2)">' + esc(g.basis) + '</div>'
          : '<div style="font-size:12.5px;color:var(--ink-2)">目标岗位「' + esc(g.forJob) + '」要求 ' + esc(g.req) + ' 分，你当前 ' + esc(g.got) + ' 分。'
            + '<b>排序依据：</b>' + esc(g.basis) + '</div>')
        + '<div style="margin-top:8px"><b style="font-size:12.5px">学习任务</b><ul style="margin:4px 0 8px;padding-left:20px;font-size:12.5px">'
        + g.tasks.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>'
        + '<b style="font-size:12.5px">验收作品</b><ul style="margin:4px 0 8px;padding-left:20px;font-size:12.5px">'
        + g.deliverables.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>'
        + '<div style="font-size:11.5px;color:var(--ink-3)">预计 ' + esc(g.hours) + ' 小时（按每周 8 小时约 ' + esc(g.dueWeeks) + ' 周）｜参考：' + esc((g.resources || []).join('、')) + '</div>'
        + '</div></div>';
    }).join('');

    var reviews = (a.reviews || []).map(function (r, i) {
      var rate = (r.planned && r.done != null) ? Math.round(r.done / r.planned * 100) : null;
      return '<div class="card" style="box-shadow:none"><div class="card-head"><h3>' + esc(r.type) + '复盘 · ' + esc(r.date) + '</h3>'
        + '<button class="btn btn-sm" data-delrev="' + i + '">删除</button></div>'
        + '<div style="display:flex;gap:16px;flex-wrap:wrap">'
        + '<div class="metric" style="flex:0 0 120px"><div class="k">计划完成</div><div class="v">' + (r.planned == null ? '—' : r.planned) + '<small>条</small></div></div>'
        + '<div class="metric" style="flex:0 0 120px"><div class="k">实际完成</div><div class="v">' + (r.done == null ? '—' : r.done) + '<small>条</small></div></div>'
        + '<div class="metric" style="flex:0 0 120px"><div class="k">完成率</div><div class="v">' + (rate == null ? '—' : rate) + '<small>%</small></div></div>'
        + '<div class="metric" style="flex:0 0 120px"><div class="k">逾期未完成</div><div class="v">' + (r.overdue == null ? '—' : r.overdue) + '<small>条</small></div></div>'
        + '</div>'
        + '<div style="font-size:12.5px;margin-top:8px"><b>本期新增证据：</b>' + esc(r.evidence || '—') + '</div>'
        + '<div style="font-size:12.5px"><b>下周最高优先级：</b>' + esc(r.next || '—') + '</div></div>';
    }).join('');

    var doneCount = actions.filter(function (x) { return x.status === 'done'; }).length;
    var overdue = actions.filter(function (x) {
      return x.status !== 'done' && x.due && x.due < CP.dateOnly();
    }).length;

    // 逐年规划建议：只读呈现，锚到具体学年，并附带取自本人测评结果的个性化要点
    var planRows = CP.yearPlan(a, res.score, res.decision, res.match);
    var yearPlanHtml = planRows.length
      ? '<ol class="yearplan">' + planRows.map(function (r) {
        return '<li><b class="yp-year">' + esc(r.year) + '</b>'
          + '<div class="yp-body"><div class="yp-action">' + esc(r.action) + '</div>'
          + (r.focus && r.focus.length
            ? '<ul class="yp-focus">' + r.focus.map(function (f) {
              return '<li>' + esc(f) + '</li>';
            }).join('') + '</ul>'
            : '')
          + '<div class="yp-note">' + esc(r.note) + '</div></div></li>';
      }).join('') + '</ol>'
      : '<div class="empty">先完成决策输入，这里会给出逐年安排。</div>';

    return head('行动计划与复盘',
      '把差距和里程碑落成带截止日的任务。复盘只记可核对的事实（计划/完成/逾期/证据）与下一步，不做感想式描述。')
      + '<div class="grid grid-4" style="margin-bottom:14px">'
      + '<div class="metric"><div class="k">任务总数</div><div class="v">' + actions.length + '<small>条</small></div></div>'
      + '<div class="metric"><div class="k">已完成</div><div class="v">' + doneCount + '<small>条</small></div>'
      + '<div class="progress" style="margin-top:6px"><i style="width:' + (actions.length ? (doneCount / actions.length * 100).toFixed(0) : 0) + '%"></i></div></div>'
      + '<div class="metric"><div class="k">已逾期未完成</div><div class="v" style="' + (overdue ? 'color:var(--danger)' : '') + '">' + overdue + '<small>条</small></div></div>'
      + '<div class="metric"><div class="k">每周可投入</div><div class="v">' + (a.decision.hoursPerWeek == null ? '—' : a.decision.hoursPerWeek) + '<small>小时</small></div></div>'
      + '</div>'
      + '<div class="actions-bar no-print" style="margin-bottom:14px">'
      + '<button class="btn btn-primary btn-sm" id="draftActions">按测评结果生成行动计划草案</button>'
      + '<button class="btn btn-sm" id="addAction">+ 手动添加任务</button>'
      + '<span class="spacer"></span>'
      + '<span style="font-size:12px;color:var(--ink-3)">共 ' + actions.length + ' 条</span>'
      + '</div>'
      + '<div class="kanban">' + col('todo', '待做') + col('doing', '进行中') + col('done', '已完成') + '</div>'

      // 长期规划建议：系统给出的逐年安排，不是填空。
      // 学生最缺的不是"写下来的地方"，而是"每个阶段该做什么"的判断。
      + '<div class="card" style="margin-top:14px"><div class="card-head"><h3>逐年规划建议</h3>'
      + '<span class="tag tag-brand">系统建议 · 结合你的测评结果</span></div>'
      + '<div style="font-size:12.5px;color:var(--ink-2);margin-bottom:10px">'
      + '从「' + esc(a.profile.grade || '大三') + '」起算的阶段安排，已经过去的学年不会出现。'
      + '骨架对各专业方向都一样；下面每条绿底的**重点**取自你自己的测评结果'
      + '（能力缺口、兴趣方向、目标岗位的学历门槛），不是通用建议。</div>'
      + yearPlanHtml
      + '</div>'

      + '<div class="card" style="margin-top:14px"><div class="card-head"><h3>差距 → 学习任务</h3>'
      + '<span class="tag">' + esc(res.match.isFreshman ? '贴合兴趣的优先' : '按缺口严重度排序') + '</span></div>'
      + (gapCards || '<div class="empty">先去完成测评并查看结果，这里会自动生成差距任务。</div>')
      + '</div>'
      + '<div class="card"><div class="card-head"><h3>复盘记录</h3><span class="tag">周 / 月 / 里程碑</span></div>'
      + (reviews || '<div class="empty">还没有复盘记录。建议每周花 3 分钟填一次：计划几条、实际完成几条、下周最重要的一件事。</div>')
      + '<div class="grid grid-4" style="margin-top:12px">'
      + '<label class="field"><span class="lbl">类型</span><select id="revType"><option>周</option><option>月</option><option>里程碑</option></select></label>'
      + '<label class="field"><span class="lbl">日期</span><input type="date" id="revDate"></label>'
      + '<label class="field"><span class="lbl">本期计划完成（条）</span><input type="number" id="revPlanned" min="0" value=""></label>'
      + '<label class="field"><span class="lbl">实际完成（条）</span><input type="number" id="revDone" min="0" value=""></label>'
      + '</div>'
      + '<div class="grid grid-4">'
      + '<label class="field"><span class="lbl">逾期未完成（条）</span><input type="number" id="revOverdue" min="0" value=""></label>'
      + '<label class="field" style="grid-column:span 3"><span class="lbl">本期新增的证据（作品名 / 链接 / 仓库）</span><input type="text" id="revEvidence"></label>'
      + '</div>'
      + '<label class="field"><span class="lbl">下周最高优先级的一件事</span><input type="text" id="revNext"></label>'
      + '<button class="btn btn-sm btn-primary" id="addReview">保存这条复盘</button>'
      + '</div>';
  };

  CP.pages.actionBind = function () {
    var a = CP.ui.archive;

    // 逐年规划建议是只读的，没有需要绑定的事件
    var draft = document.getElementById('draftActions');
    if (draft) draft.onclick = function () {
      var res = CP.ui.result();
      var acts = CP.draftActions(a, res.score, res.match, res.decision);
      if (a.actions.length && !confirm('将在现有 ' + a.actions.length + ' 条任务后追加 ' + acts.length + ' 条草案，继续吗？')) return;
      a.actions = a.actions.concat(acts);
      CP.store.save(a);
      CP.ui.go('action');
      CP.ui.toast('已追加 ' + acts.length + ' 条行动任务');
    };

    var addA = document.getElementById('addAction');
    if (addA) addA.onclick = function () {
      var title = prompt('任务内容：');
      if (!title) return;
      var due = prompt('截止日期（YYYY-MM-DD，可留空）：') || '';
      a.actions.push({
        id: 'a' + Date.now().toString(36),
        title: title, due: /^\d{4}-\d{2}-\d{2}$/.test(due) ? due : null,
        status: 'todo', evidence: '', fromGap: null, note: ''
      });
      CP.store.save(a);
      CP.ui.go('action');
    };

    // 看板状态流转的动画。
    //
    // 与排序那边同样是"整页重渲染"，所以同用 FLIP：量旧位置 → 重渲染 →
    // 量新位置 → 从旧位置滑过去。区别是这里卡片还会**跨列**，位移是二维的，
    // 所以量的是 (left, top) 两个方向。
    //
    // 光"滑过去"还不够：三列卡片长得一样，用户点完不容易看出卡去了哪一列。
    // 所以落位后再给它一次状态色反馈——边框与光晕用目标列的颜色
    // （进行中=品牌青绿，已完成=成功绿），"已完成"额外加一点庆祝感。
    function kanPositions() {
      var map = {};
      document.querySelectorAll('.kan-item[data-actid]').forEach(function (el) {
        var r = el.getBoundingClientRect();
        map[el.getAttribute('data-actid')] = { left: r.left, top: r.top };
      });
      return map;
    }
    function kanFlipPlay(first, actId, to) {
      var el = document.querySelector('.kan-item[data-actid="' + actId + '"]');
      if (!el || !first) return;
      var from = first[actId];
      var reduced = CP.ui.motionReduced && CP.ui.motionReduced();

      // 被移走的那张卡：从旧位置滑到新位置。
      // flipSlide 会先把它设成不可见，避免"先在终点闪一下再滑过去"。
      var dx = 0, dy = 0;
      if (from) {
        var r = el.getBoundingClientRect();
        dx = from.left - r.left;
        dy = from.top - r.top;
      }
      CP.ui.flipSlide(el, dx, dy, function () {
        // 落位反馈放在滑动**之后**：滑行期间元素是隐藏的，
        // 若同时播会被藏掉一半。先滑到位、再亮一下，层次也更清楚。
        if (reduced || !to) return;
        el.classList.remove('kan-land', 'kan-land-done');
        void el.offsetWidth;
        el.classList.add(to === 'done' ? 'kan-land-done' : 'kan-land');
        el.addEventListener('animationend', function onLand() {
          el.classList.remove('kan-land', 'kan-land-done');
          el.removeEventListener('animationend', onLand);
        });
      });
      // 【临时】旧的直接 animate 写法（会闪），用于验证测试有效性后删除
      if (false && (dx || dy) && typeof el.animate === 'function') {
        el.animate([
          { transform: 'translate(' + dx + 'px,' + dy + 'px)' },
          { transform: 'translate(0,0)' }
        ], { duration: 300, easing: 'cubic-bezier(.22,.61,.36,1)' });
      }

      // ★ 目标列里原有卡片必须避让。
      //   只处理被移动的那一张是不够的：它在 DOM 里是**追加**进目标列的，
      //   插入位置之后的卡片虽然视觉上被挤开了，但它们的 DOM 顺序没变，
      //   按"元素自身新旧位置差"算出来的位移是 0，于是原地不动、生硬地跳过去。
      //   这里改用**位置容器**的思路：目标列当前占位的顶部已让给新卡，
      //   而它原本是那样排列的——所以把这些卡片按"整列重新排布"来补动画。
      var targetCol = el.closest('.kan-col');
      if (!targetCol) return;
      var movedIds = {};
      movedIds[actId] = 1;
      document.querySelectorAll('.kan-item[data-actid]').forEach(function (card) {
        var id = card.getAttribute('data-actid');
        if (movedIds[id]) return;                 // 被移动的那张已经处理
        if (card.closest('.kan-col') !== targetCol) return;
        var old = first[id];
        if (!old) return;
        var now = card.getBoundingClientRect();
        var ox = old.left - now.left;
        var oy = old.top - now.top;
        if (!ox && !oy) return;
        CP.ui.flipSlide(card, ox, oy);
      });
    }

    document.querySelectorAll('[data-mv]').forEach(function (b) {
      b.onclick = function () {
        var i = Number(b.getAttribute('data-mv'));
        var to = b.getAttribute('data-to');
        var act = a.actions[i];
        if (!act || act.status === to) return;      // 已在该列，不做无意义的动画
        var actId = act.id;
        act.status = to;
        CP.store.save(a);

        var first = kanPositions();
        // 换页动画与 FLIP 都由 go() 的 keepScroll===false 触发；
        // afterRender 在 DOM 写好之后执行，此时新位置已经可量。
        CP.ui.afterRender = function () { kanFlipPlay(first, actId, to); };
        CP.ui.go('action');
      };
    });
    document.querySelectorAll('[data-del]').forEach(function (b) {
      b.onclick = function () {
        a.actions.splice(Number(b.getAttribute('data-del')), 1);
        CP.store.save(a);
        CP.ui.go('action');
      };
    });
    document.querySelectorAll('[data-delrev]').forEach(function (b) {
      b.onclick = function () {
        a.reviews.splice(Number(b.getAttribute('data-delrev')), 1);
        CP.store.save(a);
        CP.ui.go('action');
      };
    });

    var addR = document.getElementById('addReview');
    if (addR) addR.onclick = function () {
      function num(id) {
        var v = document.getElementById(id).value;
        return v === '' ? null : Number(v);
      }
      var planned = num('revPlanned');
      var done = num('revDone');
      if (planned == null || done == null) { CP.ui.toast('请至少填写"计划完成"和"实际完成"的条数'); return; }
      a.reviews.push({
        date: document.getElementById('revDate').value || CP.dateOnly(),
        type: document.getElementById('revType').value,
        planned: planned,
        done: done,
        overdue: num('revOverdue'),
        evidence: document.getElementById('revEvidence').value.trim(),
        next: document.getElementById('revNext').value.trim()
      });
      CP.store.save(a);
      CP.ui.go('action');
      CP.ui.toast('复盘已保存');
    };
  };

  /* ============================================================
   * 导出报告
   * ============================================================ */
  CP.pages.export = function () {
    var a = CP.ui.archive;
    var missing = CP.validateArchive(a);
    var ready = missing.length === 0;

    return head('导出报告',
      '主要交付物是一份 <b>PDF 报告</b>（A4、含图表、可直接提交）；'
      + '另有供核查的原始数据与可备份的档案。')
      + '<div class="card"><div class="card-head"><h3>导出前检查</h3>'
      + '<span class="tag' + (ready ? ' tag-ok' : ' tag-warn') + '">' + (ready ? '资料完整' : '还差 ' + missing.length + ' 项') + '</span></div>'
      + (ready ? '<div class="note note-ok">所有必填内容已完成，导出的报告可以直接提交。</div>'
        : '<ul style="margin:0;padding-left:20px;font-size:13px">' + missing.map(function (m) { return '<li>' + esc(m) + '</li>'; }).join('') + '</ul>')
      + '</div>'

      // 主交付物：PDF 报告。占满一行、按钮用主色，视觉上与其他导出明确区分
      + '<div class="export-card export-main" style="margin-top:16px">'
      + '<div class="export-icon">印</div>'
      + '<div class="export-main-body">'
      + '<h3>规划报告（PDF）'
      + '<span class="tag tag-brand">主交付物</span></h3>'
      + '<div class="desc">A4 排版，封面 + 五章正文 + 一页计算口径附录，含兴趣六边形、能力对照与职业简表。'
      + '章节各自起新页，表格跨页重复表头，配色保留。</div>'
      + '<div class="export-steps"><b>三步得到 PDF：</b>'
      + '<span>① 点下方按钮生成打印排版</span><span>② 在新页面按 <kbd>Ctrl</kbd>+<kbd>P</kbd>（Mac 为 <kbd>⌘</kbd>+<kbd>P</kbd>）</span>'
      + '<span>③ 打印机选「另存为 PDF」，纸张 A4</span></div>'
      + '</div>'
      + '<div class="export-main-act">'
      + '<button class="btn btn-primary" id="expPrint">生成可打印页面</button>'
      + '</div></div>'

      + '<div class="grid grid-3" style="margin-top:16px">'

      + '<div class="export-card"><div class="export-icon">文</div>'
      + '<h3>规划报告（Markdown）</h3><span class="tag" style="align-self:flex-start;margin-bottom:8px">纯文本备选</span>'
      + '<div class="desc">与 PDF 同源的五章正文，存为 <code>.md</code>。适合需要二次编辑、'
      + '或要粘进其他文档系统的场合。图形与排版会丢失。</div>'
      + '<button class="btn btn-sm" id="expMd">导出 Markdown</button></div>'

      + '<div class="export-card"><div class="export-icon">表</div>'
      + '<h3>原始数据（CSV + JSON）</h3><span class="tag" style="align-self:flex-start;margin-bottom:8px">供核查</span>'
      + '<div class="desc">全部作答明细：每题内容、原始作答、归一化得分、所属维度；'
      + '外加行业岗位库与路径库的完整参数表（可当附录用）。报告里每个结论都能在这里找到来源。</div>'
      + '<button class="btn btn-sm" id="expRaw">导出原始数据</button></div>'

      + '<div class="export-card"><div class="export-icon">档</div>'
      + '<h3>档案 JSON</h3><span class="tag" style="align-self:flex-start;margin-bottom:8px">备份 / 续做</span>'
      + '<div class="desc">包含全部原始作答与计算结果，可在本工作台上重新导入以继续编辑。'
      + '换电脑、重装浏览器之前请先导出这个文件。</div>'
      + '<button class="btn btn-sm" id="expJson">导出档案 JSON</button></div>'

      + '</div>'

      + '<div class="card" style="margin-top:14px"><div class="card-head"><h3>数据说明（请随报告一并提交）</h3></div><div class="disclaimer">'
      + '<p><b>1. 这不是心理诊断工具。</b>测评题目为课程自编，改编自霍兰德职业兴趣理论、施恩职业锚理论等公开框架，不等同于任何标准化心理量表。</p>'
      + '<p><b>2. 岗位库是示例数据。</b>11 个岗位族的能力要求与薪资区间是对公开行业报告与招聘信息描述的结构化转写，用于教学演示，不代表实时招聘行情。来源清单见 <code>情报库/岗位来源.md</code>。</p>'
      + '<p><b>3. 计算过程可复核。</b>所有权重、公式与门槛规则见 <code>文档/数据字典.md</code>；导出的原始数据包含每题得分，可手工复算。</p>'
      + '</div></div>';
  };

  CP.pages.exportBind = function () {
    var j = document.getElementById('expJson');
    if (j) j.onclick = function () { CP.report.saveArchive(); };
    var m = document.getElementById('expMd');
    if (m) m.onclick = function () { CP.report.downloadMarkdown(); };
    var p = document.getElementById('expPrint');
    if (p) p.onclick = function () { CP.report.openPrintView(); };
    var r = document.getElementById('expRaw');
    if (r) r.onclick = function () { CP.report.downloadRawData(); };
  };

  /* ---------------- 各页面的绑定分发 ---------------- */
  CP.bindPage = function (route) {
    var fn = CP.pages[route + 'Bind'];
    if (typeof fn === 'function') fn();
  };
})(typeof globalThis !== 'undefined' ? globalThis : this);
